# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Vercel KV Configuration (for production)
# These will be automatically set by Vercel when you add KV to your project
KV_REST_API_URL=your-vercel-kv-rest-api-url
KV_REST_API_TOKEN=your-vercel-kv-rest-api-token
KV_REST_API_READ_ONLY_TOKEN=your-vercel-kv-read-only-token

# Production Configuration
# For production, set NODE_ENV=production
# Make sure to use a strong JWT_SECRET in production
# Vercel KV credentials will be automatically provided by Vercel